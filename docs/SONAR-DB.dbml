// ════════════════════════════════════════════════════════════════
//  SONAR — 해상물류 공급망 리스크 레이더
//  데이터 모델 (ERD)
//
//  https://dbdiagram.io 에 붙여넣으면 ERD 가 자동 생성됩니다.
//  엔터티 23 · 액터 2 (화물 운영 담당자 / 시스템 관리자)
// ════════════════════════════════════════════════════════════════


// ───────────────────────── ENUM ─────────────────────────

Enum company_type {
  SHIPPER
  FORWARDER
  PLATFORM
}

Enum user_role {
  OPERATOR
  ADMIN
}

Enum user_status {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

Enum shipment_status {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  IN_TRANSIT
  ARRIVED
  REJECTED
  CANCELLED
}

Enum voyage_status {
  SCHEDULED
  IN_TRANSIT
  DELAYED
  ARRIVED
}

Enum source_type {
  NEWS
  GOV
  NOTICE
  WEATHER
  SOCIAL
}

Enum feed_process_status {
  PENDING
  PROCESSED
  DISCARDED
  FAILED
}

Enum event_type {
  GEOPOLITICAL
  WEATHER
  PORT_CONGESTION
  LABOR_STRIKE
  SANCTION
  ACCIDENT
  EPIDEMIC
  REGULATION
  PIRACY
}

Enum event_status {
  DRAFT
  PUBLISHED
  EXPIRED
  DISMISSED
}

Enum area_type {
  PORT
  CHOKEPOINT
}

Enum match_reason {
  CHOKEPOINT_TRANSIT
  PORT_CALL
  ORIGIN
  DESTINATION
}

Enum match_status {
  OPEN
  ACKNOWLEDGED
  ACTION_TAKEN
  RESOLVED
  FALSE_POSITIVE
}

Enum risk_grade {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

Enum action_type {
  REROUTE
  EXPEDITE
  NOTIFY_CUSTOMER
  INSURANCE_CLAIM
  HOLD
  MONITOR
  OTHER
}

Enum action_result {
  PENDING
  IN_PROGRESS
  DONE
  FAILED
}

Enum notification_channel {
  ALIMTALK
  EMAIL
  IN_APP
}

Enum notification_scope {
  INTERNAL
  EXTERNAL
}

Enum notification_status {
  DRAFT
  PENDING_APPROVAL
  SENT
  FAILED
  REJECTED
}

Enum job_status {
  SUCCESS
  PARTIAL
  FAILED
}


// ═══════════════ 1. 테넌트 · 사용자 ═══════════════

Table company {
  company_id   varchar(10)  [pk]
  name         varchar(100) [not null]
  biz_reg_no   varchar(20)  [unique, note: '사업자등록번호']
  company_type company_type [not null, default: 'SHIPPER']
  created_at   timestamp    [not null, default: `now()`]

  Note: '''
  멀티테넌시 단위. 화주(SHIPPER)와 포워더(FORWARDER)를 모두 수용한다.
  PLATFORM 은 SONAR 운영본부(시스템 관리자 소속) 전용.
  '''
}

Table user {
  user_id       varchar(10)  [pk]
  company_id    varchar(10)  [not null]
  email         varchar(255) [not null, unique]
  password_hash varchar(255) [not null, note: 'bcrypt 해시']
  name          varchar(50)  [not null]
  phone         varchar(20)
  department    varchar(50)
  role          user_role    [not null, default: 'OPERATOR']
  status        user_status  [not null, default: 'PENDING']
  reject_reason varchar(500) [note: 'status = REJECTED 일 때만 사용']
  created_at    timestamp    [not null, default: `now()`]
  approved_at   timestamp
  approved_by   varchar(10)  [note: '승인 처리한 관리자']
  last_login_at timestamp

  Indexes {
    (company_id, status)
    email [unique]
  }

  Note: '''
  가입 시 status = PENDING 으로 생성되며 관리자 승인 후에만 로그인할 수 있다.
  RDB 예약어와 충돌하는 환경에서는 app_user 로 매핑한다.
  '''
}


// ═══════════════ 2. 지리 · 선박 마스터 ═══════════════

Table port {
  port_id      varchar(10) [pk]
  unlocode     char(5)     [not null, unique, note: 'UN/LOCODE (예: KRPUS)']
  name_ko      varchar(50) [not null]
  name_en      varchar(50) [not null]
  country_code char(2)     [not null, note: 'ISO 3166-1 alpha-2']
  region_code  varchar(10) [not null, note: 'NEA / SEA / SAS / MEA / EUR / NAM / LAM / OCE']
  lat          decimal(8,5) [not null]
  lon          decimal(8,5) [not null]
}

Table choke_point {
  choke_point_id varchar(10) [pk]
  code           varchar(20) [not null, unique, note: 'HORMUZ / SUEZ / MALACCA …']
  name_ko        varchar(50) [not null]
  name_en        varchar(50) [not null]
  lat            decimal(8,5) [not null]
  lon            decimal(8,5) [not null]
  radius_km      int         [not null, note: '영향 반경. 지도 표시 및 매칭 판정에 사용']

  Note: '해상 요충지(해협·운하). 항만이 아닌 통과 구간의 리스크를 표현하기 위한 엔터티'
}

Table carrier {
  carrier_id varchar(10) [pk]
  name       varchar(50) [not null]
  scac_code  char(4)     [unique, note: 'Standard Carrier Alpha Code']
}

Table vessel {
  vessel_id    varchar(10) [pk]
  imo_no       char(7)     [not null, unique, note: 'IMO 선박식별번호']
  name         varchar(60) [not null]
  carrier_id   varchar(10) [not null]
  vessel_type  varchar(20) [not null, default: 'CONTAINER']
  capacity_teu int
}

Table voyage {
  voyage_id           varchar(10)   [pk]
  vessel_id           varchar(10)   [not null]
  voyage_no           varchar(20)   [not null, note: '항차 번호 (예: 0128E)']
  service_route_name  varchar(60)   [note: '선사 서비스 루프명']
  status              voyage_status [not null, default: 'SCHEDULED']
  current_lat         decimal(8,5)  [note: 'AIS 최신 위치']
  current_lon         decimal(8,5)
  current_speed_kn    decimal(4,1)
  current_heading     smallint      [note: '0~359']
  position_updated_at timestamp

  Indexes { (vessel_id, voyage_no) [unique] }
  Note: '지도에 표시되는 선박 아이콘의 좌표 원천'
}

Table voyage_leg {
  voyage_leg_id varchar(10) [pk]
  voyage_id     varchar(10) [not null]
  seq           smallint    [not null, note: '기항 순서']
  port_id       varchar(10) [not null]
  eta           date
  etd           date

  Indexes { (voyage_id, seq) [unique] }
  Note: '항차의 기항 스케줄. 중간 기항지 매칭(PORT_CALL)의 판정 근거'
}

Table voyage_transit {
  voyage_transit_id     varchar(10) [pk]
  voyage_id             varchar(10) [not null]
  choke_point_id        varchar(10) [not null]
  expected_passage_date date        [not null]

  Indexes { (voyage_id, choke_point_id) [unique] }
  Note: '항차가 통과할 해상 요충지와 예정일'
}


// ═══════════════ 3. 화물 (운송 건) ═══════════════

Table shipment {
  shipment_id                 varchar(10)     [pk]
  shipment_no                 varchar(30)     [not null, unique, note: '화물 관리번호 (예: SNR-2026-0001)']
  company_id                  varchar(10)     [not null]
  owner_user_id               varchar(10)     [not null, note: '담당자']
  voyage_id                   varchar(10)     [note: '선박 미배정 시 NULL']
  origin_port_id              varchar(10)     [not null]
  destination_port_id         varchar(10)     [not null]
  commodity                   varchar(100)    [not null, note: '품목']
  cargo_value_usd             decimal(14,2)   [not null, note: '노출도(가액) 계산 입력']
  currency                    char(3)         [not null, default: 'USD']
  incoterms                   varchar(10)     [not null, default: 'FOB']
  container_no                varchar(20)
  container_type              varchar(10)     [not null, default: '40HC']
  container_count             smallint        [not null, default: 1]
  weight_kg                   int
  customer_name               varchar(100)    [note: '수하인 / 고객사']
  etd                         date            [not null, note: '출항 예정일']
  eta                         date            [not null, note: '도착 예정일']
  customer_due_date           date            [not null, note: '고객 납기일. ETA 와의 차이가 납기 여유']
  alternative_route_available boolean         [not null, default: false, note: '노출도(경로 경직성) 계산 입력']
  status                      shipment_status [not null, default: 'PENDING_APPROVAL']
  memo                        varchar(500)
  reject_reason               varchar(500)    [note: 'status = REJECTED 일 때만 사용']
  created_at                  timestamp       [not null, default: `now()`]
  approved_at                 timestamp
  approved_by                 varchar(10)     [note: '승인 처리한 관리자']

  Indexes {
    (company_id, status)
    (owner_user_id)
    (eta)
  }

  Note: '''
  서비스의 중심 엔터티. 담당자가 등록하고 관리자가 승인한다.
  CHECK (eta >= etd), CHECK (customer_due_date >= eta), CHECK (cargo_value_usd > 0)
  '''
}

Table shipment_route_point {
  shipment_route_point_id varchar(10) [pk]
  shipment_id             varchar(10) [not null]
  seq                     smallint    [not null]
  choke_point_id          varchar(10) [not null]
  expected_passage_date   date        [not null]

  Indexes {
    (shipment_id, seq) [unique]
    (choke_point_id, expected_passage_date)
  }

  Note: '''
  화물이 통과할 해상 요충지와 예정일.
  항차 배정 시 voyage_transit 에서 파생되고, 미배정 시 출발·도착항으로 자동 산출된다.
  요충지 통과 매칭(CHOKEPOINT_TRANSIT)의 직접 판정 근거.
  '''
}


// ═══════════════ 4. 리스크 수집 · 정형화 파이프라인 ═══════════════

Table risk_source {
  source_id            varchar(10)  [pk]
  name                 varchar(100) [not null]
  source_type          source_type  [not null]
  url                  varchar(500) [not null, unique]
  language             char(2)      [not null, default: 'en']
  trust_weight         decimal(3,2) [not null, default: 0.80, note: '0.00~1.00. 신뢰도 계수에 직접 곱해짐']
  collect_interval_min int          [not null, default: 60]
  enabled              boolean      [not null, default: true]
  last_collected_at    timestamp

  Note: '관리자가 등록·관리하는 수집 대상. trust_weight 변경 시 전체 리스크 점수가 재계산된다'
}

Table raw_feed {
  raw_feed_id    varchar(10)         [pk]
  source_id      varchar(10)         [not null]
  external_id    varchar(100)        [not null, note: '소스 내 고유 식별자']
  title          varchar(500)        [not null]
  body           text                [not null, note: '원문 본문']
  url            varchar(500)
  published_at   timestamp           [not null]
  collected_at   timestamp           [not null, default: `now()`]
  process_status feed_process_status [not null, default: 'PENDING']
  discard_reason varchar(500)        [note: 'process_status = DISCARDED 일 때만 사용']

  Indexes {
    (source_id, external_id) [unique]
    (process_status, collected_at)
  }

  Note: '수집된 뉴스·공지·기상 정보의 원문. 담당자 화면에서 정형화 결과와 대조 가능'
}

Table risk_event {
  event_id          varchar(10)  [pk]
  raw_feed_id       varchar(10)  [not null]
  event_type        event_type   [not null]
  status            event_status [not null, default: 'DRAFT']
  title             varchar(200) [not null]
  summary           text         [not null]
  severity          smallint     [not null, note: '1~5. CHECK (severity BETWEEN 1 AND 5)']
  confidence        decimal(3,2) [not null, note: '0.00~1.00. LLM 확신도']
  start_date        date         [not null, note: '영향 시작일']
  expected_end_date date         [not null, note: '영향 종료 예상일']
  llm_model         varchar(50)  [note: '정형화에 사용한 모델']
  llm_extracted_at  timestamp
  reviewed_by       varchar(10)  [note: '검토한 관리자']
  reviewed_at       timestamp
  review_note       varchar(500) [note: '판단 근거 / 기각 사유']
  published_at      timestamp

  Indexes {
    (status, start_date)
    (event_type)
    raw_feed_id [unique]
  }

  Note: '''
  LLM 이 원문을 유형·심각도·신뢰도·기간으로 구조화한 결과.
  관리자가 수정·검토한 뒤 PUBLISHED 로 발행해야 담당자 화면에 노출되고 매칭이 수행된다.
  CHECK (expected_end_date >= start_date)
  '''
}

Table event_area {
  event_area_id       varchar(10) [pk]
  event_id            varchar(10) [not null]
  area_type           area_type   [not null]
  port_id             varchar(10) [note: 'area_type = PORT 일 때만']
  choke_point_id      varchar(10) [note: 'area_type = CHOKEPOINT 일 때만']
  impact_level        smallint    [not null, note: '1~5. 해당 지역에 국한된 영향 강도']
  expected_delay_days smallint    [not null, default: 0]
  start_date          date        [note: 'NULL 이면 이벤트 기간을 따름']
  end_date            date

  Indexes {
    (event_id)
    (port_id)
    (choke_point_id)
  }

  Note: '''
  이벤트가 영향을 미치는 지역. 항만 또는 해상 요충지 중 하나를 가리킨다.
  CHECK ((area_type = 'PORT' AND port_id IS NOT NULL AND choke_point_id IS NULL)
      OR (area_type = 'CHOKEPOINT' AND choke_point_id IS NOT NULL AND port_id IS NULL))
  '''
}

Table collection_job {
  job_id          varchar(10) [pk]
  source_id       varchar(10) [not null]
  started_at      timestamp   [not null]
  finished_at     timestamp
  status          job_status  [not null]
  fetched_count   int         [not null, default: 0]
  processed_count int         [not null, default: 0]
  error_message   varchar(500)

  Indexes { (source_id, started_at) }
  Note: '주기적 수집 작업의 실행 이력. 관리자 대시보드의 파이프라인 현황에 사용'
}


// ═══════════════ 5. 매칭 · 리스크 점수 ═══════════════

Table impact_match {
  match_id            varchar(10)   [pk]
  event_id            varchar(10)   [not null]
  shipment_id         varchar(10)   [not null]
  company_id          varchar(10)   [not null, note: '테넌트 격리용 비정규화. shipment 조인 없이 필터링']
  event_area_id       varchar(10)   [not null, note: '매칭을 성립시킨 영향 지역']
  match_reason        match_reason  [not null]
  exposure_date       date          [not null, note: '실제 노출 시점 (통과일 또는 기항일)']
  overlap_start       date          [not null, note: '운송 기간 ∩ 이벤트 기간']
  overlap_end         date          [not null]
  expected_delay_days smallint      [not null, default: 0]
  buffer_days         smallint      [not null, note: '고객 납기일 − ETA']
  risk_score          smallint      [not null, note: '0~100']
  risk_grade          risk_grade    [not null]
  severity_factor     decimal(6,4)  [not null, note: '(심각도/5)×0.7 + (지역 영향도/5)×0.3']
  exposure_factor     decimal(6,4)  [not null, note: '0.4 + 0.6×(가액 0.35 + 납기긴급도 0.40 + 경로경직성 0.25)']
  confidence_factor   decimal(6,4)  [not null, note: 'LLM 확신도 × 소스 신뢰가중치']
  provisional         boolean       [not null, default: false, note: '화물 승인 전 잠정 결과']
  status              match_status  [not null, default: 'OPEN']
  created_at          timestamp     [not null, default: `now()`]
  updated_at          timestamp     [not null, default: `now()`]

  Indexes {
    (event_id, shipment_id) [unique]
    (company_id, risk_score)
    (status)
    (exposure_date)
  }

  Note: '''
  서비스의 핵심 산출물. "이벤트 영향지역 × 화물 운송구간 × 일정 겹침" 3중 교집합으로 생성된다.
  riskScore = 100 × severity_factor × exposure_factor × confidence_factor
  하나의 (이벤트, 화물) 쌍에 대해 가장 높은 점수의 근거 1건만 대표로 저장한다.
  '''
}

Table risk_threshold {
  threshold_id      varchar(10) [pk]
  grade             risk_grade  [not null, unique]
  min_score         smallint    [not null, note: '0~100']
  max_score         smallint    [not null]
  color             char(7)     [note: 'UI 표시 색상 (#RRGGBB)']
  notify_enabled    boolean     [not null, default: true, note: '해당 등급 알림 발송 여부']
  requires_approval boolean     [not null, default: false, note: '대외 발송 시 관리자 승인 필요 여부']
  updated_by        varchar(10)
  updated_at        timestamp   [not null, default: `now()`]

  Note: '''
  등급 구간과 알림 정책. 관리자가 변경하면 전체 impact_match 의 등급이 재계산된다.
  구간은 0~100 사이에서 빈틈 없이 연속되어야 한다. CHECK (min_score <= max_score)
  '''
}


// ═══════════════ 6. 대응 · 피드백 ═══════════════

Table response_playbook {
  playbook_id                    varchar(10)  [pk]
  event_type                     varchar(20)  [not null, note: "event_type 값 또는 '*'(전체 적용)"]
  min_grade                      risk_grade   [not null, note: '이 등급 이상일 때 제안']
  action_type                    action_type  [not null]
  title                          varchar(100) [not null]
  description                    varchar(500) [not null]
  estimated_cost_usd             decimal(12,2) [not null, default: 0]
  estimated_delay_reduction_days smallint     [not null, default: 0]
  sort_order                     smallint     [not null, default: 1]

  Note: '이벤트 유형과 리스크 등급에 따라 제안되는 대응 시나리오 템플릿'
}

Table action_log {
  action_id   varchar(10)   [pk]
  match_id    varchar(10)   [not null]
  playbook_id varchar(10)   [note: '템플릿 없이 직접 입력한 경우 NULL']
  user_id     varchar(10)   [not null, note: '조치를 등록한 담당자']
  action_type action_type   [not null]
  content     varchar(1000) [not null]
  result      action_result [not null, default: 'PENDING']
  result_note varchar(500)
  acted_at    timestamp     [not null]
  created_at  timestamp     [not null, default: `now()`]

  Indexes { (match_id, acted_at) }
  Note: '영향 건에 대해 실제로 수행한 조치 기록. 등록 시 match.status 가 ACTION_TAKEN 으로 전이'
}

Table match_feedback {
  feedback_id       varchar(10)  [pk]
  match_id          varchar(10)  [not null]
  user_id           varchar(10)  [not null]
  is_relevant       boolean      [not null, note: 'false = 오탐 신고']
  actual_delay_days smallint     [note: '실제 발생한 지연 일수']
  comment           varchar(500)
  created_at        timestamp    [not null, default: `now()`]

  Indexes { (match_id) }
  Note: '''
  매칭 정확도(Precision) 산출 및 오탐 관리의 원천.
  is_relevant = false 이면 match.status 가 FALSE_POSITIVE 로 전이된다.
  '''
}


// ═══════════════ 7. 알림 · 감사 ═══════════════

Table notification {
  notification_id     varchar(10)           [pk]
  match_id            varchar(10)           [note: '영향 건 기반 알림. 이벤트 단위 공지는 NULL']
  event_id            varchar(10)           [note: '알림의 원인 이벤트']
  shipment_id         varchar(10)           [note: '알림 대상 화물']
  recipient_user_id   varchar(10)           [not null]
  requested_by        varchar(10)           [note: 'NULL = 임계값 초과에 의한 시스템 자동 발송']
  approved_by         varchar(10)           [note: '대외 발송 승인 관리자']
  channel             notification_channel  [not null, default: 'ALIMTALK']
  scope               notification_scope    [not null, default: 'INTERNAL']
  title               varchar(200)          [not null]
  message             varchar(1000)         [not null]
  status              notification_status   [not null, default: 'DRAFT']
  approved_at         timestamp
  sent_at             timestamp
  read_at             timestamp
  fail_reason         varchar(500)
  created_at          timestamp             [not null, default: `now()`]

  Indexes {
    (recipient_user_id, status)
    (status, created_at)
  }

  Note: '''
  사내(INTERNAL) 발송은 임계값 초과 시 자동 전송되고,
  대외(EXTERNAL) 발송은 PENDING_APPROVAL 상태로 관리자 승인 대기열에 들어간다.
  '''
}

Table audit_log {
  audit_id      varchar(10)  [pk]
  actor_user_id varchar(10)  [not null]
  action        varchar(50)  [not null, note: 'EVENT_PUBLISH / SHIPMENT_APPROVE / THRESHOLD_UPDATE …']
  target_type   varchar(30)  [not null, note: 'RISK_EVENT / SHIPMENT / USER / NOTIFICATION …']
  target_id     varchar(20)  [not null]
  detail        varchar(500)
  ip            varchar(45)  [note: 'IPv4 / IPv6']
  created_at    timestamp    [not null, default: `now()`]

  Indexes {
    (actor_user_id, created_at)
    (target_type, target_id)
  }

  Note: '관리자의 시스템 변경 이력. 기준 변경·승인·기각의 추적 가능성 확보'
}


// ═══════════════ 관계 정의 ═══════════════

// 테넌트 · 사용자
Ref: user.company_id             > company.company_id            // 1:N
Ref: user.approved_by            > user.user_id                  // 자기참조 (승인자)

// 선박 · 항차
Ref: vessel.carrier_id           > carrier.carrier_id            // 1:N
Ref: voyage.vessel_id            > vessel.vessel_id              // 1:N
Ref: voyage_leg.voyage_id        > voyage.voyage_id              // 1:N
Ref: voyage_leg.port_id          > port.port_id                  // 1:N
Ref: voyage_transit.voyage_id    > voyage.voyage_id              // 1:N
Ref: voyage_transit.choke_point_id > choke_point.choke_point_id  // 1:N

// 화물
Ref: shipment.company_id          > company.company_id           // 1:N
Ref: shipment.owner_user_id       > user.user_id                 // 1:N
Ref: shipment.approved_by         > user.user_id                 // 1:N
Ref: shipment.voyage_id           > voyage.voyage_id             // 1:N (선택)
Ref: shipment.origin_port_id      > port.port_id                 // 1:N
Ref: shipment.destination_port_id > port.port_id                 // 1:N
Ref: shipment_route_point.shipment_id    > shipment.shipment_id  // 1:N
Ref: shipment_route_point.choke_point_id > choke_point.choke_point_id // 1:N

// 리스크 파이프라인
Ref: raw_feed.source_id       > risk_source.source_id            // 1:N
Ref: risk_event.raw_feed_id   - raw_feed.raw_feed_id             // 1:1
Ref: risk_event.reviewed_by   > user.user_id                     // 1:N
Ref: event_area.event_id      > risk_event.event_id              // 1:N
Ref: event_area.port_id       > port.port_id                     // 1:N
Ref: event_area.choke_point_id > choke_point.choke_point_id      // 1:N
Ref: collection_job.source_id > risk_source.source_id            // 1:N

// 매칭 (risk_event ↔ shipment 의 M:N 을 해소하는 교차 엔터티)
Ref: impact_match.event_id      > risk_event.event_id            // 1:N
Ref: impact_match.shipment_id   > shipment.shipment_id           // 1:N
Ref: impact_match.company_id    > company.company_id             // 1:N
Ref: impact_match.event_area_id > event_area.event_area_id       // 1:N

// 대응 · 피드백
Ref: action_log.match_id       > impact_match.match_id           // 1:N
Ref: action_log.playbook_id    > response_playbook.playbook_id   // 1:N
Ref: action_log.user_id        > user.user_id                    // 1:N
Ref: match_feedback.match_id   > impact_match.match_id           // 1:N
Ref: match_feedback.user_id    > user.user_id                    // 1:N

// 알림 · 감사
Ref: notification.match_id          > impact_match.match_id      // 1:N
Ref: notification.event_id          > risk_event.event_id        // 1:N
Ref: notification.shipment_id       > shipment.shipment_id       // 1:N
Ref: notification.recipient_user_id > user.user_id               // 1:N
Ref: notification.requested_by      > user.user_id               // 1:N
Ref: notification.approved_by       > user.user_id               // 1:N
Ref: risk_threshold.updated_by      > user.user_id               // 1:N
Ref: audit_log.actor_user_id        > user.user_id               // 1:N


// ═══════════════ 그룹 (dbdiagram 시각 정리용) ═══════════════

TableGroup tenant_and_user {
  company
  user
}

TableGroup geo_and_vessel_master {
  port
  choke_point
  carrier
  vessel
  voyage
  voyage_leg
  voyage_transit
}

TableGroup shipment_domain {
  shipment
  shipment_route_point
}

TableGroup risk_pipeline {
  risk_source
  raw_feed
  risk_event
  event_area
  collection_job
}

TableGroup matching_and_scoring {
  impact_match
  risk_threshold
}

TableGroup response_and_feedback {
  response_playbook
  action_log
  match_feedback
}

TableGroup notification_and_audit {
  notification
  audit_log
}

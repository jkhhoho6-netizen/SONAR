// ════════════════════════════════════════════════════════════════
//  SONAR — 해상물류 공급망 리스크 레이더
//  데이터 모델 (ERD)
//
//  https://dbdiagram.io 에 붙여넣으면 ERD 가 자동 생성됩니다.
//  엔터티 18 · 관계 30
//
//  [API 식별자 매핑]
//  API 는 사용자가 읽기 쉬운 이름을 쓰고, 모델은 통합 엔터티를 쓴다.
//    portId / originPortId / destinationPortId  →  location.location_id (location_type = PORT)
//    chokePointId                               →  location.location_id (location_type = CHOKEPOINT)
//    Port / ChokePoint 스키마                    →  location 의 타입별 뷰
//    CollectionJob 스키마                        →  risk_source 의 last_* 컬럼 뷰
//    Feedback 스키마                             →  impact_match 의 feedback_* 컬럼 뷰
// ════════════════════════════════════════════════════════════════


// ───────────────────────── ENUM ─────────────────────────

Enum company_type {
  SHIPPER
  FORWARDER
  PLATFORM
}

Enum user_role {
  OPERATOR
  ADMIN
}

Enum user_status {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

Enum location_type {
  PORT
  CHOKEPOINT
}

Enum leg_type {
  PORT_CALL
  TRANSIT
}

Enum voyage_status {
  SCHEDULED
  IN_TRANSIT
  DELAYED
  ARRIVED
}

Enum shipment_status {
  PENDING_APPROVAL
  ACTIVE
  IN_TRANSIT
  ARRIVED
  REJECTED
  CANCELLED
}

Enum source_type {
  NEWS
  GOV
  NOTICE
  WEATHER
  SOCIAL
}

Enum feed_process_status {
  PENDING
  PROCESSED
  DISCARDED
  FAILED
}

Enum event_type {
  GEOPOLITICAL
  WEATHER
  PORT_CONGESTION
  LABOR_STRIKE
  SANCTION
  ACCIDENT
  EPIDEMIC
  REGULATION
  PIRACY
}

Enum event_status {
  DRAFT
  PUBLISHED
  EXPIRED
  DISMISSED
}

Enum match_reason {
  CHOKEPOINT_TRANSIT
  PORT_CALL
  ORIGIN
  DESTINATION
}

Enum match_status {
  OPEN
  ACKNOWLEDGED
  ACTION_TAKEN
  RESOLVED
  FALSE_POSITIVE
}

Enum risk_grade {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

Enum action_type {
  REROUTE
  EXPEDITE
  NOTIFY_CUSTOMER
  INSURANCE_CLAIM
  HOLD
  MONITOR
  OTHER
}

Enum action_result {
  PENDING
  IN_PROGRESS
  DONE
  FAILED
}

Enum notification_channel {
  ALIMTALK
  EMAIL
  IN_APP
}

Enum notification_scope {
  INTERNAL
  EXTERNAL
}

Enum notification_status {
  PENDING_APPROVAL
  SENT
  FAILED
  REJECTED
}

Enum job_status {
  SUCCESS
  PARTIAL
  FAILED
}


// ═══════════════ 1. 테넌트 · 사용자 ═══════════════

Table company {
  company_id   varchar(10)  [pk]
  name         varchar(100) [not null]
  biz_reg_no   varchar(20)  [unique, note: '사업자등록번호']
  company_type company_type [not null, default: 'SHIPPER']
  created_at   timestamp    [not null, default: `now()`]

  Note: '멀티테넌시 단위. 화주(SHIPPER)와 포워더(FORWARDER)를 모두 수용한다.'
}

Table user {
  user_id       varchar(10)  [pk]
  company_id    varchar(10)  [not null]
  email         varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  name          varchar(50)  [not null]
  phone         varchar(20)
  department    varchar(50)
  role          user_role    [not null, default: 'OPERATOR']
  status        user_status  [not null, default: 'PENDING']
  reject_reason varchar(500)
  created_at    timestamp    [not null, default: `now()`]
  approved_at   timestamp
  approved_by   varchar(10)  [note: '승인 처리한 관리자']
  last_login_at timestamp

  Indexes {
    (company_id, status)
  }

  Note: '가입 시 PENDING 으로 생성되며 관리자 승인 후에만 로그인할 수 있다.'
}


// ═══════════════ 2. 지리 · 선박 기준정보 ═══════════════

Table location {
  location_id   varchar(10)   [pk]
  location_type location_type [not null]
  code          varchar(20)   [not null, unique, note: '항만은 UN/LOCODE(KRPUS), 요충지는 식별코드(HORMUZ)']
  name_ko       varchar(50)   [not null]
  name_en       varchar(50)   [not null]
  country_code  char(2)       [note: '요충지는 NULL']
  region_code   varchar(10)   [note: 'NEA / SEA / SAS / MEA / EUR / NAM / LAM / OCE']
  lat           decimal(8,5)  [not null]
  lon           decimal(8,5)  [not null]
  radius_km     int           [note: '요충지의 영향 반경. 항만은 NULL']

  Note: '''
  항만과 해상 요충지(해협·운하)를 하나로 통합한 지리 마스터.

  둘을 나누면 event_area 가 두 개의 배타적 FK 를 갖게 되어 모델이 복잡해진다.
  성격이 같은 "좌표를 가진 리스크 지점"이므로 location_type 으로 구분한다.
  API 의 Port / ChokePoint 스키마는 이 테이블의 타입별 뷰(projection)다.
  '''
}

Table vessel {
  vessel_id    varchar(10) [pk]
  imo_no       char(7)     [not null, unique, note: 'IMO 선박식별번호']
  name         varchar(60) [not null]
  carrier_name varchar(50) [not null, note: '선사명. 선사는 표시 용도뿐이라 별도 엔터티로 두지 않는다']
  vessel_type  varchar(20) [not null, default: 'CONTAINER']
  capacity_teu int
}

Table voyage {
  voyage_id           varchar(10)   [pk]
  vessel_id           varchar(10)   [not null]
  voyage_no           varchar(20)   [not null, note: '항차 번호 (예: 0128E)']
  service_route_name  varchar(60)   [note: '선사 서비스 루프명']
  status              voyage_status [not null, default: 'SCHEDULED']
  current_lat         decimal(8,5)  [note: 'AIS 최신 위치. 지도의 선박 아이콘 좌표']
  current_lon         decimal(8,5)
  current_speed_kn    decimal(4,1)
  position_updated_at timestamp

  Indexes {
    (vessel_id, voyage_no) [unique]
  }
}

Table voyage_leg {
  voyage_leg_id varchar(10) [pk]
  voyage_id     varchar(10) [not null]
  seq           smallint    [not null, note: '항차 내 순서']
  leg_type      leg_type    [not null, note: 'PORT_CALL 기항 / TRANSIT 요충지 통과']
  location_id   varchar(10) [not null]
  eta           date        [note: '기항 도착 예정일 또는 요충지 통과 예정일']
  etd           date        [note: '기항 출항 예정일. TRANSIT 은 NULL']

  Indexes {
    (voyage_id, seq) [unique]
  }

  Note: '''
  항차가 거쳐가는 모든 지점을 한 테이블로 관리한다.
  기항지와 통과 요충지는 "날짜를 가진 경유 지점"이라는 점에서 같으므로
  leg_type 으로만 구분하고 테이블을 나누지 않는다.
  '''
}


// ═══════════════ 3. 화물 ═══════════════

Table shipment {
  shipment_id                 varchar(10)     [pk]
  shipment_no                 varchar(30)     [not null, unique, note: '화물 관리번호 (예: SNR-2026-0001)']
  company_id                  varchar(10)     [not null]
  owner_user_id               varchar(10)     [not null, note: '담당자']
  voyage_id                   varchar(10)     [note: '선박 미배정 시 NULL']
  origin_location_id          varchar(10)     [not null, note: '출발항']
  destination_location_id     varchar(10)     [not null, note: '도착항']
  commodity                   varchar(100)    [not null]
  cargo_value_usd             decimal(14,2)   [not null, note: '노출도(가액) 계산 입력']
  incoterms                   varchar(10)     [not null, default: 'FOB']
  container_no                varchar(20)
  container_type              varchar(10)     [not null, default: '40HC']
  container_count             smallint        [not null, default: 1]
  weight_kg                   int
  customer_name               varchar(100)
  etd                         date            [not null, note: '출항 예정일']
  eta                         date            [not null, note: '도착 예정일']
  customer_due_date           date            [not null, note: '고객 납기일. ETA 와의 차이가 납기 여유']
  alternative_route_available boolean         [not null, default: false, note: '노출도(경로 경직성) 계산 입력']
  status                      shipment_status [not null, default: 'PENDING_APPROVAL']
  memo                        varchar(500)
  reject_reason               varchar(500)
  created_at                  timestamp       [not null, default: `now()`]
  approved_at                 timestamp
  approved_by                 varchar(10)

  Indexes {
    (company_id, status)
    (eta)
  }

  Note: '''
  서비스의 중심 엔터티. 담당자가 등록하고 관리자가 승인한다.
  CHECK (eta >= etd), CHECK (customer_due_date >= eta), CHECK (cargo_value_usd > 0)
  '''
}

Table shipment_leg {
  shipment_leg_id       varchar(10) [pk]
  shipment_id           varchar(10) [not null]
  seq                   smallint    [not null]
  location_id           varchar(10) [not null, note: '통과 예정 해상 요충지']
  expected_passage_date date        [not null]

  Indexes {
    (shipment_id, seq) [unique]
    (location_id, expected_passage_date)
  }

  Note: '''
  화물이 통과할 요충지와 예정일. 요충지 통과 매칭의 직접 판정 근거.
  항차가 배정되면 voyage_leg 에서 파생되고, 미배정이면 출발·도착항으로 자동 산출한다.
  '''
}


// ═══════════════ 4. 리스크 수집 · 정형화 ═══════════════

Table risk_source {
  source_id            varchar(10)  [pk]
  name                 varchar(100) [not null]
  source_type          source_type  [not null]
  url                  varchar(500) [not null, unique]
  trust_weight         decimal(3,2) [not null, default: 0.80, note: '0.00~1.00. 신뢰도 계수에 직접 곱해진다']
  collect_interval_min int          [not null, default: 60]
  enabled              boolean      [not null, default: true]
  last_collected_at    timestamp
  last_job_status      job_status   [note: '최근 수집 실행 결과']
  last_fetched_count   int
  last_error_message   varchar(500)

  Note: '''
  관리자가 등록·관리하는 수집 대상.
  수집 실행 이력은 애플리케이션 로그로 남기고, 모델에는 최근 1회 결과만 유지한다.
  trust_weight 변경 시 전체 리스크 점수가 재계산된다.
  '''
}

Table raw_feed {
  raw_feed_id    varchar(10)         [pk]
  source_id      varchar(10)         [not null]
  external_id    varchar(100)        [not null, note: '소스 내 고유 식별자']
  title          varchar(500)        [not null]
  body           text                [not null, note: '원문 본문']
  url            varchar(500)
  published_at   timestamp           [not null]
  collected_at   timestamp           [not null, default: `now()`]
  process_status feed_process_status [not null, default: 'PENDING']
  discard_reason varchar(500)

  Indexes {
    (source_id, external_id) [unique]
    (process_status, collected_at)
  }

  Note: '수집된 뉴스·공지·기상 정보의 원문. 담당자 화면에서 정형화 결과와 대조할 수 있다.'
}

Table risk_event {
  event_id          varchar(10)  [pk]
  raw_feed_id       varchar(10)  [not null, unique, note: '원문 1건당 이벤트 1건 (1:1)']
  event_type        event_type   [not null]
  status            event_status [not null, default: 'DRAFT']
  title             varchar(200) [not null]
  summary           text         [not null]
  severity          smallint     [not null, note: '1~5. CHECK (severity BETWEEN 1 AND 5)']
  confidence        decimal(3,2) [not null, note: '0.00~1.00. LLM 확신도']
  start_date        date         [not null]
  expected_end_date date         [not null]
  llm_model         varchar(50)
  llm_extracted_at  timestamp
  reviewed_by       varchar(10)  [note: '검토한 관리자']
  reviewed_at       timestamp
  review_note       varchar(500) [note: '판단 근거 / 기각 사유']
  published_at      timestamp

  Indexes {
    (status, start_date)
  }

  Note: '''
  LLM 이 원문을 유형·심각도·신뢰도·기간으로 구조화한 결과.
  관리자가 검토해 PUBLISHED 로 발행해야 담당자 화면에 노출되고 매칭이 수행된다.
  CHECK (expected_end_date >= start_date)
  '''
}

Table event_area {
  event_area_id       varchar(10) [pk]
  event_id            varchar(10) [not null]
  location_id         varchar(10) [not null, note: '항만 또는 해상 요충지']
  impact_level        smallint    [not null, note: '1~5. 해당 지역에 국한된 영향 강도']
  expected_delay_days smallint    [not null, default: 0]

  Indexes {
    (event_id, location_id) [unique]
  }

  Note: '이벤트가 영향을 미치는 지역. 영향 기간은 이벤트의 기간을 따른다.'
}


// ═══════════════ 5. 매칭 · 대응 ═══════════════

Table impact_match {
  match_id            varchar(10)  [pk]
  event_id            varchar(10)  [not null]
  shipment_id         varchar(10)  [not null]
  event_area_id       varchar(10)  [not null, note: '매칭을 성립시킨 영향 지역']
  match_reason        match_reason [not null]
  exposure_date       date         [not null, note: '실제 노출 시점 (통과일 또는 기항일)']
  expected_delay_days smallint     [not null, default: 0]
  buffer_days         smallint     [not null, note: '고객 납기일 − ETA']
  risk_score          smallint     [not null, note: '0~100']
  risk_grade          risk_grade   [not null]
  severity_factor     decimal(6,4) [not null, note: '(심각도/5)×0.7 + (지역 영향도/5)×0.3']
  exposure_factor     decimal(6,4) [not null, note: '0.4 + 0.6×(가액 0.35 + 납기긴급도 0.40 + 경로경직성 0.25)']
  confidence_factor   decimal(6,4) [not null, note: 'LLM 확신도 × 소스 신뢰가중치']
  provisional         boolean      [not null, default: false, note: '화물 승인 전 잠정 결과']
  status              match_status [not null, default: 'OPEN']
  feedback_is_relevant      boolean     [note: 'false = 오탐. 매칭 정확도 산출의 원천']
  feedback_actual_delay_days smallint   [note: '실제 발생한 지연 일수']
  feedback_comment          varchar(500)
  feedback_by               varchar(10) [note: '피드백을 남긴 담당자']
  feedback_at               timestamp
  created_at          timestamp    [not null, default: `now()`]
  updated_at          timestamp    [not null, default: `now()`]

  Indexes {
    (event_id, shipment_id) [unique]
    (risk_score)
    (status)
  }

  Note: '''
  서비스의 핵심 산출물. "이벤트 영향지역 × 화물 운송구간 × 일정 겹침" 3중 교집합으로 생성된다.
  riskScore = 100 × severity_factor × exposure_factor × confidence_factor
  하나의 (이벤트, 화물) 쌍에 대해 가장 높은 점수의 근거 1건만 대표로 저장한다.

  매칭 피드백은 건당 1회만 남기므로 별도 엔터티 없이 feedback_* 컬럼으로 기록한다.
  feedback_is_relevant = false 이면 status 가 FALSE_POSITIVE 로 전이된다.
  '''
}

Table response_playbook {
  playbook_id                    varchar(10)   [pk]
  event_type                     varchar(20)   [not null, note: "event_type 값 또는 '*'(전체 적용)"]
  min_grade                      risk_grade    [not null, note: '이 등급 이상일 때 제안']
  action_type                    action_type   [not null]
  title                          varchar(100)  [not null]
  description                    varchar(500)  [not null]
  estimated_cost_usd             decimal(12,2) [not null, default: 0]
  estimated_delay_reduction_days smallint      [not null, default: 0]

  Note: '이벤트 유형과 리스크 등급에 따라 제안되는 대응 시나리오 템플릿'
}

Table action_log {
  action_id   varchar(10)   [pk]
  match_id    varchar(10)   [not null]
  playbook_id varchar(10)   [note: '템플릿 없이 직접 입력한 경우 NULL']
  user_id     varchar(10)   [not null]
  action_type action_type   [not null]
  content     varchar(1000) [not null]
  result      action_result [not null, default: 'PENDING']
  result_note varchar(500)
  acted_at    timestamp     [not null]

  Indexes {
    (match_id, acted_at)
  }

  Note: '영향 건에 대해 수행한 조치 기록. 등록 시 match.status 가 ACTION_TAKEN 으로 전이된다.'
}

Table risk_threshold {
  grade             risk_grade [pk, note: '등급이 곧 식별자 (4행 고정)']
  min_score         smallint   [not null, note: '0~100']
  max_score         smallint   [not null]
  notify_enabled    boolean    [not null, default: true]
  requires_approval boolean    [not null, default: false, note: '대외 발송 시 관리자 승인 필요 여부']
  updated_at        timestamp  [not null, default: `now()`]

  Note: '''
  등급 구간과 알림 정책. 관리자가 변경하면 전체 impact_match 의 등급이 재계산된다.
  구간은 0~100 사이에서 빈틈 없이 연속되어야 한다. CHECK (min_score <= max_score)
  '''
}


// ═══════════════ 6. 알림 · 감사 ═══════════════

Table notification {
  notification_id   varchar(10)          [pk]
  match_id          varchar(10)          [not null, note: '이벤트·화물은 이 매칭을 통해 확인한다']
  recipient_user_id varchar(10)          [not null]
  requested_by      varchar(10)          [note: 'NULL = 임계값 초과에 의한 시스템 자동 발송']
  approved_by       varchar(10)          [note: '대외 발송 승인 관리자']
  channel           notification_channel [not null, default: 'ALIMTALK']
  scope             notification_scope   [not null, default: 'INTERNAL']
  title             varchar(200)         [not null]
  message           varchar(1000)        [not null]
  status            notification_status  [not null]
  sent_at           timestamp
  read_at           timestamp
  fail_reason       varchar(500)
  created_at        timestamp            [not null, default: `now()`]

  Indexes {
    (recipient_user_id, status)
  }

  Note: '''
  사내(INTERNAL) 발송은 임계값 초과 시 자동 전송되고,
  대외(EXTERNAL) 발송은 PENDING_APPROVAL 로 관리자 승인 대기열에 들어간다.
  '''
}

Table audit_log {
  audit_id      varchar(10) [pk]
  actor_user_id varchar(10) [not null]
  action        varchar(50) [not null, note: 'EVENT_PUBLISH / SHIPMENT_APPROVE / THRESHOLD_UPDATE …']
  target_type   varchar(30) [not null]
  target_id     varchar(20) [not null]
  detail        varchar(500)
  created_at    timestamp   [not null, default: `now()`]

  Indexes {
    (actor_user_id, created_at)
  }

  Note: '관리자의 시스템 변경 이력. 기준 변경·승인·기각의 추적 가능성 확보'
}


// ═══════════════ 관계 ═══════════════

// 테넌트 · 사용자
Ref: user.company_id                   > company.company_id      // 1:N
Ref: user.approved_by                  > user.user_id            // 자기참조

// 선박 · 항차
Ref: voyage.vessel_id                  > vessel.vessel_id        // 1:N
Ref: voyage_leg.voyage_id              > voyage.voyage_id        // 1:N
Ref: voyage_leg.location_id            > location.location_id    // 1:N

// 화물
Ref: shipment.company_id               > company.company_id      // 1:N
Ref: shipment.owner_user_id            > user.user_id            // 1:N
Ref: shipment.approved_by              > user.user_id            // 1:N
Ref: shipment.voyage_id                > voyage.voyage_id        // 1:N
Ref: shipment.origin_location_id       > location.location_id    // 1:N
Ref: shipment.destination_location_id  > location.location_id    // 1:N
Ref: shipment_leg.shipment_id          > shipment.shipment_id    // 1:N
Ref: shipment_leg.location_id          > location.location_id    // 1:N

// 리스크 파이프라인
Ref: raw_feed.source_id                > risk_source.source_id   // 1:N
Ref: risk_event.raw_feed_id            - raw_feed.raw_feed_id    // 1:1
Ref: risk_event.reviewed_by            > user.user_id            // 1:N
Ref: event_area.event_id               > risk_event.event_id     // 1:N
Ref: event_area.location_id            > location.location_id    // 1:N

// 매칭 — risk_event ↔ shipment 의 M:N 을 해소하는 교차 엔터티
Ref: impact_match.event_id             > risk_event.event_id     // 1:N
Ref: impact_match.shipment_id          > shipment.shipment_id    // 1:N
Ref: impact_match.event_area_id        > event_area.event_area_id// 1:N
Ref: impact_match.feedback_by          > user.user_id            // 1:N

// 대응
Ref: action_log.match_id               > impact_match.match_id   // 1:N
Ref: action_log.playbook_id            > response_playbook.playbook_id // 1:N
Ref: action_log.user_id                > user.user_id            // 1:N

// 알림 · 감사
Ref: notification.match_id             > impact_match.match_id   // 1:N
Ref: notification.recipient_user_id    > user.user_id            // 1:N
Ref: notification.requested_by         > user.user_id            // 1:N
Ref: notification.approved_by          > user.user_id            // 1:N
Ref: audit_log.actor_user_id           > user.user_id            // 1:N


// ═══════════════ 그룹 ═══════════════

TableGroup tenant_and_user {
  company
  user
}

TableGroup master_data {
  location
  vessel
  voyage
  voyage_leg
}

TableGroup shipment_domain {
  shipment
  shipment_leg
}

TableGroup risk_pipeline {
  risk_source
  raw_feed
  risk_event
  event_area
}

TableGroup matching_and_response {
  impact_match
  response_playbook
  action_log
  risk_threshold
}

TableGroup notification_and_audit {
  notification
  audit_log
}
